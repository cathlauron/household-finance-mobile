{
  "expo": {
    "name": "Finance Flow",
    "slug": "mobile-app",
    "scheme": "financeflow",
    "version": "3.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fc22064f-0d07-4d26-814d-61d99dbe6efd",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1b372c"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.cathlauron.householdfinance",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your household finances quickly."
      }
    },
    "android": {
      "package": "com.cathlauron.householdfinance",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#122b21"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your household finances quickly."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Finance Flow to access your photos so you can choose a profile picture or attach receipts.",
          "microphonePermission": "Finance Flow uses the microphone only while you tap \"Say it\", to fill in a form from what you say."
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Finance Flow uses your approximate location to match the sky on Home to your sunrise, sunset and weather.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Finance Flow uses the camera to scan a household invite QR code.",
          "microphonePermission": "Finance Flow uses the microphone only while you tap \"Say it\", to fill in a form from what you say.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Finance Flow uses the microphone only while you tap \"Say it\", to fill in a form from what you say.",
          "speechRecognitionPermission": "Finance Flow turns what you say into words to fill in a form. Nothing is saved until you tap Save.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LeftToSpend",
              "label": "Left to spend",
              "description": "What you can spend until payday",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/left-to-spend.png"
            },
            {
              "name": "SayIt",
              "label": "Say it",
              "description": "Add anything by speaking",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview/say-it.png"
            },
            {
              "name": "SpendSay",
              "label": "Spend & say",
              "description": "Left to spend, this week, Say it and Add",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/spend-say.png"
            },
            {
              "name": "DueSoon",
              "label": "Due soon",
              "description": "Your next bills",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/due-soon.png"
            },
            {
              "name": "Month",
              "label": "Month at a glance",
              "description": "Left to spend, budgets and bills",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/month.png"
            },
            {
              "name": "Trip",
              "label": "Trip",
              "description": "Your trip's spending while it's on",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/trip.png"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fc22064f-0d07-4d26-814d-61d99dbe6efd"
      }
    },
    "owner": "cathlauron"
  }
}
