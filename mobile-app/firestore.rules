rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /linkCodes/{code} {
      allow get: if request.auth != null;
      allow write: if request.auth != null &&
        (
          (request.resource.data.keys().hasAll(['codeSalt', 'encryptedSecret', 'encryptedHostData', 'hostUsername'])
            && request.resource.data.codeSalt is string
            && request.resource.data.encryptedSecret is string
            && request.resource.data.encryptedHostData is string
            && request.resource.data.hostUsername is string)
          ||
          (request.resource.data.finished == true
            && request.resource.data.householdId is string)
        );
      allow delete: if false;
      allow list: if false;
    }

    match /households/{householdId} {
      allow get: if request.auth != null
        && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['data', 'updatedAt', 'members'])
        && request.resource.data.data is string
        && request.resource.data.updatedAt is number
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.keys().hasAll(['data', 'updatedAt']);

      allow delete: if false;
      allow list: if false;
    }

    match /householdKeys/{username} {
      allow get: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['householdId', 'wrappedKey', 'updatedAt', 'ownerUid'])
        && request.resource.data.householdId is string
        && request.resource.data.wrappedKey is string
        && request.resource.data.updatedAt is number
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;

      allow list: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
