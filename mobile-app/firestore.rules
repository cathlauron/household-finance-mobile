rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /linkCodes/{code} {
      // A code is only readable for a short window after it's created — after
      // that, Firestore denies the read outright, so an old code sitting in a
      // screenshot or chat log can't be used to link into someone's data
      // indefinitely.
      allow get: if request.auth != null
        && request.time < resource.data.createdAt + duration.value(15, 'm');

      allow write: if request.auth != null &&
        (
          (request.resource.data.keys().hasAll(['codeSalt', 'encryptedSecret', 'encryptedHostData', 'hostUsername'])
            && request.resource.data.codeSalt is string
            && request.resource.data.encryptedSecret is string
            && request.resource.data.encryptedHostData is string
            && request.resource.data.hostUsername is string)
          ||
          (request.resource.data.finished == true
            && request.resource.data.householdId is string)
        );

      // Once a code has done its job (successfully used to link two
      // profiles), it's deleted outright rather than left sitting around
      // forever as a still-working decryption key.
      allow delete: if request.auth != null && resource.data.finished == true;

      allow list: if false;
    }

    match /households/{householdId} {
      allow get: if request.auth != null
        && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['data', 'updatedAt', 'members', 'owner'])
        && request.resource.data.data is string
        && request.resource.data.updatedAt is number
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 5
        && request.resource.data.owner is string
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && (!('memberUsernames' in request.resource.data)
            || (request.resource.data.memberUsernames is map
                && request.resource.data.memberUsernames.keys().hasOnly([request.auth.uid])
                && request.resource.data.memberUsernames[request.auth.uid] is string));

      // Normal edits to the encrypted household data itself — the members
      // list must stay exactly as it was; joining/leaving is handled by the
      // two rules below instead, so this one can no longer be used to
      // sneak a membership change through alongside a data edit.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt']);
      // Lets someone who isn't a member yet join by adding their own uid to
      // the members list — this is what addMemberToHousehold() does when the
      // host finishes linking into a household the joiner already created.
      // Only the members field is allowed to change here, and the person can
      // only add themselves, not anyone else.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUsernames'])
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 5
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && (!('memberUsernames' in request.resource.data)
            || (request.resource.data.memberUsernames is map
                && request.resource.data.memberUsernames.diff(resource.data.get('memberUsernames', {})).affectedKeys().hasOnly([request.auth.uid])
                && request.resource.data.memberUsernames[request.auth.uid] is string));
      // Mirror image of the rule above — lets a currently-linked member
      // remove ONLY THEMSELVES from the members list. This is what
      // removeMemberFromHousehold() does when a profile unlinks. A member
      // can never use this to remove anyone else's access.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && resource.data.get('owner', null) != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUsernames'])
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
        && (!('memberUsernames' in request.resource.data)
            || (request.resource.data.memberUsernames is map
                && request.resource.data.memberUsernames.diff(resource.data.get('memberUsernames', {})).affectedKeys().hasOnly([request.auth.uid])));

      // Lets the owner remove another member while remaining in the household.
      // The resulting members list may only remove existing members; it cannot
      // add arbitrary UIDs outside the link-code flow.
      allow update: if request.auth != null
        && resource.data.get('owner', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUsernames'])
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 5
        && request.auth.uid in request.resource.data.members
        && resource.data.members.hasAll(request.resource.data.members)
        && (!('memberUsernames' in request.resource.data)
            || (request.resource.data.memberUsernames is map
                && request.resource.data.memberUsernames.diff(resource.data.get('memberUsernames', {})).affectedKeys().hasOnly(resource.data.members.removeAll(request.resource.data.members))));

      // Lets the owner leave while transferring ownership to an existing
      // member, atomically removing the old owner and setting the new owner.
      allow update: if request.auth != null
        && resource.data.get('owner', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'owner', 'memberUsernames'])
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 5
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.owner is string
        && request.resource.data.owner in resource.data.members
        && request.resource.data.owner in request.resource.data.members
        && resource.data.members.hasAll(request.resource.data.members)
        && (!('memberUsernames' in request.resource.data)
            || (request.resource.data.memberUsernames is map
                && request.resource.data.memberUsernames.diff(resource.data.get('memberUsernames', {})).affectedKeys().hasOnly([request.auth.uid])));

      // Dissolve household (sole remaining member, or owner dissolving a 2-member household)
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.members
        && (resource.data.members.size() == 1 || (resource.data.members.size() <= 2 && resource.data.get('owner', null) == request.auth.uid));

      allow list: if false;
    }

    match /householdKeys/{username} {
      allow get: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['householdId', 'wrappedKey', 'updatedAt', 'ownerUid'])
        && request.resource.data.householdId is string
        && request.resource.data.wrappedKey is string
        && request.resource.data.updatedAt is number
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.get('ownerUid', request.auth.uid)
        && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;

      allow list: if false;
    }
    match /profileBackups/{username} {
      // Checkpoint A.5 — one backup document per username, holding the salt
      // (and, for a linked profile, the householdId) a brand-new device
      // needs to restore itself. `data` is the encrypted personal model,
      // only meaningful/present for an unlinked profile.
      //
      // NOTE: this collection is keyed by username, not uid — there's no
      // `ownerUid` field on it the way householdKeys has, because it needs
      // to be readable by anyone who knows the username (that's the whole
      // point: a signed-in-but-brand-new device hasn't linked this username
      // to anything locally yet). Being logged into Firebase Auth at all
      // (request.auth != null) is what's gating access, not per-document
      // ownership.
      allow get: if request.auth != null;

      allow write: if request.auth != null
        && request.resource.data.keys().hasAll(['salt', 'updatedAt'])
        && request.resource.data.salt is string
        && request.resource.data.updatedAt is number
        && (!('householdId' in request.resource.data) || request.resource.data.householdId is string)
        && (!('data' in request.resource.data) || request.resource.data.data is string);

      allow list: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
