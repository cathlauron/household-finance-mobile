rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Security (2026-10-16): true when the signed-in account has claimed this username
    // (usernames/{username}.uid). Records filed under a username can only be CREATED by
    // the account that claimed it, so nobody can grab someone else's username first.
    function ownsUsername(username) {
      return exists(/databases/$(database)/documents/usernames/$(username))
        && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }

    // Username claims: created once by the account that owns the username, never changed.
    // Any signed-in account can check whether a username is taken (it only shows an
    // account id, nothing else).
    match /usernames/{username} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && username.size() > 0 && username.size() <= 60;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list: if false;
    }

    match /linkCodes/{code} {
      // A code is only readable for a short window after it's created — after
      // that, Firestore denies the read outright, so an old code sitting in a
      // screenshot or chat log can't be used to link into someone's data
      // indefinitely.
      allow get: if request.auth != null
        && (request.time < resource.data.createdAt + duration.value(15, 'm')
            // Version 2.1: the person who MADE the code can still read their own code
            // after 15 minutes, so their phone can finish linking once the other person
            // has joined. Nobody else gets the extra time.
            || resource.data.hostUid == request.auth.uid);

      // SEC-1 (Cath's OK, 2026-10-27): a code can only point at a household its maker is a
      // member of, and may carry only the fields the app writes. Before, anyone signed in
      // could make a code for someone else's household and use it to join.
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['codeSalt', 'encryptedSecret', 'encryptedHostData', 'hostUsername', 'hostUid', 'createdAt', 'existingHouseholdId'])
        && request.resource.data.keys().hasOnly(['codeSalt', 'encryptedSecret', 'encryptedHostData', 'hostUsername', 'hostUid', 'createdAt', 'existingHouseholdId', 'isInvite'])
        && request.resource.data.existingHouseholdId is string
        && exists(/databases/$(database)/documents/households/$(request.resource.data.existingHouseholdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.existingHouseholdId)).data.members
        && (!('isInvite' in request.resource.data) || request.resource.data.isInvite is bool)
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid is string
        && request.resource.data.codeSalt is string
        && request.resource.data.encryptedSecret is string
        && request.resource.data.encryptedHostData is string
        && request.resource.data.hostUsername is string
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && request.resource.data.hostUid == resource.data.hostUid
        // SEC-1: which household a code is for can never change after it's made.
        && request.resource.data.get('existingHouseholdId', null) == resource.data.get('existingHouseholdId', null)
        && (
          // Host updating their own code
          request.auth.uid == resource.data.hostUid
          ||
          // Joiner announcing their username (Checkpoint 9.2d)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinerUsername'])
            && request.resource.data.joinerUsername is string)
          ||
          // Joiner completing the link (Checkpoint 9.2c)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finished', 'householdId'])
            && request.resource.data.finished == true
            && request.resource.data.householdId is string
            // SEC-1 review: only the household the code is for, by someone now in it.
            && request.resource.data.householdId == resource.data.get('existingHouseholdId', null)
            && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members)
        );

      // Only the host who created the code can delete or cancel it
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;

      allow list: if false;
    }

    match /households/{householdId} {
      allow get: if request.auth != null
        && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['data', 'updatedAt', 'members', 'owner'])
        && request.resource.data.data is string
        && request.resource.data.updatedAt is number
        && request.resource.data.members is list
        // Security (2026-10-16): a new household starts with only its creator in it;
        // others join through an invite code (rule below).
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.owner is string
        && request.resource.data.owner == request.auth.uid
        && (!('memberUsernames' in request.resource.data)
            || (request.resource.data.memberUsernames is map
                && request.resource.data.memberUsernames.keys().hasOnly([request.auth.uid])
                && request.resource.data.memberUsernames[request.auth.uid] is string));

      // Normal edits to the encrypted household data itself — the members
      // list must stay exactly as it was; joining/leaving is handled by the
      // two rules below instead, so this one can no longer be used to
      // sneak a membership change through alongside a data edit.
      // Version 2.1 (storage in parts): the same edit may also set `layout` (1 = the
      // household is stored in parts, see below) and the member's OWN entry in
      // `memberVersions` (which app version each member's phone runs). A member can never
      // change another member's entry.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt', 'layout', 'memberVersions'])
        && request.resource.data.data is string
        && request.resource.data.updatedAt is number
        && (!('layout' in request.resource.data) || request.resource.data.layout is int)
        && (!('memberVersions' in request.resource.data)
            || (request.resource.data.memberVersions is map
                && request.resource.data.memberVersions.diff(resource.data.get('memberVersions', {})).affectedKeys().hasOnly([request.auth.uid])
                // .get(): a member whose phone hasn't noted its version yet can still save.
                && request.resource.data.memberVersions.get(request.auth.uid, '') is string));
      // Lets someone who isn't a member yet join by adding their own uid to
      // the members list — this is what addMemberToHousehold() does when the
      // joiner finishes linking into the host's household. Only the members
      // field (plus the code used) may change, the person can only add
      // themselves, and (security, 2026-10-16) they must name a live invite
      // code — under 15 minutes old — that was made for THIS household.
      // Knowing a household's ID alone is not enough to join it.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUsernames', 'lastJoinCode'])
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 5
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.lastJoinCode is string
        && exists(/databases/$(database)/documents/linkCodes/$(request.resource.data.lastJoinCode))
        && get(/databases/$(database)/documents/linkCodes/$(request.resource.data.lastJoinCode)).data.existingHouseholdId == householdId
        // SEC-1: and the code was made by someone who is in this household.
        && get(/databases/$(database)/documents/linkCodes/$(request.resource.data.lastJoinCode)).data.hostUid in resource.data.members
        && request.time < get(/databases/$(database)/documents/linkCodes/$(request.resource.data.lastJoinCode)).data.createdAt + duration.value(15, 'm')
        && (!('memberUsernames' in request.resource.data)
            || (request.resource.data.memberUsernames is map
                && request.resource.data.memberUsernames.diff(resource.data.get('memberUsernames', {})).affectedKeys().hasOnly([request.auth.uid])
                && request.resource.data.memberUsernames[request.auth.uid] is string));
      // Mirror image of the rule above — lets a currently-linked member
      // remove ONLY THEMSELVES from the members list. This is what
      // removeMemberFromHousehold() does when a profile unlinks. A member
      // can never use this to remove anyone else's access.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && resource.data.get('owner', null) != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUsernames'])
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
        && (!('memberUsernames' in request.resource.data)
            || (request.resource.data.memberUsernames is map
                && request.resource.data.memberUsernames.diff(resource.data.get('memberUsernames', {})).affectedKeys().hasOnly([request.auth.uid])));

      // Lets the owner remove another member while remaining in the household.
      // The resulting members list may only remove existing members; it cannot
      // add arbitrary UIDs outside the link-code flow.
      allow update: if request.auth != null
        && resource.data.get('owner', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUsernames'])
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 5
        && request.auth.uid in request.resource.data.members
        && resource.data.members.hasAll(request.resource.data.members)
        && (!('memberUsernames' in request.resource.data)
            || (request.resource.data.memberUsernames is map
                && request.resource.data.memberUsernames.diff(resource.data.get('memberUsernames', {})).affectedKeys().hasOnly(resource.data.members.removeAll(request.resource.data.members))));

      // Lets the owner leave while transferring ownership to an existing
      // member, atomically removing the old owner and setting the new owner.
      allow update: if request.auth != null
        && resource.data.get('owner', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'owner', 'memberUsernames'])
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 5
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.owner is string
        && request.resource.data.owner in resource.data.members
        && request.resource.data.owner in request.resource.data.members
        && resource.data.members.hasAll(request.resource.data.members)
        && (!('memberUsernames' in request.resource.data)
            || (request.resource.data.memberUsernames is map
                && request.resource.data.memberUsernames.diff(resource.data.get('memberUsernames', {})).affectedKeys().hasOnly([request.auth.uid])));

      // Allows an existing member to set or clear pendingRecoveryRequestId
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingRecoveryRequestId'])
        && (request.resource.data.pendingRecoveryRequestId == null
            || request.resource.data.pendingRecoveryRequestId is string);

      // Dissolve household (sole remaining member, or owner dissolving a 2-member household)
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.members
        && (resource.data.members.size() == 1 || (resource.data.members.size() <= 2 && resource.data.get('owner', null) == request.auth.uid));

      allow list: if false;
    }

    // Version 2.1 (storage in parts): the household saved as several smaller encrypted
    // documents, because one Firestore document can hold at most 1 MiB. Only members of
    // the household can read, write or delete its parts. Each part is encrypted on the
    // phone first, just like the single `data` copy, and must stay under 1,000,000
    // characters. Parts must be deleted BEFORE the household document when a household
    // is dissolved (after that nobody is a member any more).
    match /households/{householdId}/parts/{partId} {
      function isHouseholdMember() {
        return request.auth != null
          && exists(/databases/$(database)/documents/households/$(householdId))
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
      allow get, list: if isHouseholdMember();
      allow create, update: if isHouseholdMember()
        && partId.size() <= 80
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000
        && request.resource.data.updatedAt is number
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isHouseholdMember();
    }

    match /householdKeys/{username} {
      // Security (2026-10-16): every record now has an owner, so the old "no owner =
      // anyone signed in" fallback is gone. Only the owner can read or change it.
      allow get: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && ownsUsername(username)
        && request.resource.data.keys().hasAll(['householdId', 'wrappedKey', 'updatedAt', 'ownerUid'])
        && request.resource.data.householdId is string
        && request.resource.data.wrappedKey is string
        && request.resource.data.updatedAt is number
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['householdId', 'wrappedKey', 'updatedAt', 'ownerUid'])
        && request.resource.data.householdId is string
        && request.resource.data.wrappedKey is string
        && request.resource.data.updatedAt is number;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;

      allow list: if false;
    }
    match /profileBackups/{username} {
      // Checkpoint A.5 — one backup document per username, holding the salt
      // (and, for a linked profile, the householdId) a brand-new device
      // needs to restore itself. `data` is the encrypted personal model,
      // only meaningful/present for an unlinked profile.
      //
      // Pre-Phase-B Tier 1 fix: ownerUid field added on create and required
      // on update so only the owning user can modify their backup.
      allow get: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && ownsUsername(username)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['salt', 'updatedAt', 'ownerUid'])
        && request.resource.data.ownerUid is string
        && request.resource.data.salt is string
        && request.resource.data.updatedAt is number
        && (!('householdId' in request.resource.data) || request.resource.data.householdId is string)
        && (!('data' in request.resource.data) || request.resource.data.data is string);

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['salt', 'updatedAt', 'ownerUid'])
        && request.resource.data.ownerUid is string
        && request.resource.data.salt is string
        && request.resource.data.updatedAt is number
        && (!('householdId' in request.resource.data) || request.resource.data.householdId is string)
        && (!('data' in request.resource.data) || request.resource.data.data is string);

      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      allow list: if false;
    }
    match /recoveryKeys/{username} {
      allow get: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && ownsUsername(username)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerUid', 'recoverySalt', 'wrappedKey', 'isHouseholdKey', 'updatedAt'])
        && request.resource.data.ownerUid is string
        && request.resource.data.recoverySalt is string
        && request.resource.data.wrappedKey is string
        && request.resource.data.isHouseholdKey is bool
        && request.resource.data.updatedAt is number;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerUid', 'recoverySalt', 'wrappedKey', 'isHouseholdKey', 'updatedAt'])
        && request.resource.data.ownerUid is string
        && request.resource.data.recoverySalt is string
        && request.resource.data.wrappedKey is string
        && request.resource.data.isHouseholdKey is bool
        && request.resource.data.updatedAt is number;

      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      allow list: if false;
    }
    match /householdRecovery/{requestId} {
      // K4 / SEC-4 (Cath's OK, 2026-10-27): once a member has sent the key, only the person
      // who asked can read it; other members only see a request while it's still waiting.
      allow get: if request.auth != null
        && (request.auth.uid == resource.data.requesterUid
            || (resource.data.status == 'pending'
                && request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members));

      allow create: if request.auth != null
        && request.resource.data.requesterUid == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['householdId', 'requesterUid', 'requesterUsername', 'transferSalt', 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.householdId is string
        && request.resource.data.requesterUsername is string
        && request.resource.data.transferSalt is string
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is number
        // K4: a request lasts at most 15 minutes (a minute's slack for the phone's clock).
        && request.resource.data.expiresAt <= request.time.toMillis() + 16 * 60 * 1000;

      allow update: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members
        && request.auth.uid != resource.data.requesterUid
        && resource.data.status == 'pending'
        // K4: and only while it hasn't run out.
        && request.time.toMillis() < resource.data.expiresAt
        && request.resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'encryptedHouseholdKey', 'approverUid', 'approvedAt'])
        && request.resource.data.encryptedHouseholdKey is string
        && request.resource.data.approverUid == request.auth.uid
        && request.resource.data.approvedAt is number;

      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.requesterUid
            || request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members);

      allow list: if false;
    }
    match /sessions/{uid}/devices/{deviceId} {
      allow get, list: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['deviceId', 'deviceName', 'platform', 'lastActiveAt', 'createdAt', 'revoked'])
        && request.resource.data.deviceId == deviceId
        && request.resource.data.deviceName is string
        && request.resource.data.platform is string
        && request.resource.data.lastActiveAt is number
        && request.resource.data.createdAt is number
        && request.resource.data.revoked == false;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && resource.data.revoked == false
        && (
          // Throttled heartbeat update: only lastActiveAt changes
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
           && request.resource.data.lastActiveAt is number)
          ||
          // Self sign-out: only signedOutAt changes
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signedOutAt'])
           && request.resource.data.signedOutAt is number)
          ||
          // Remote revocation: revoked transitions to true
          (request.resource.data.revoked == true
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt'])
           && (!('revokedAt' in request.resource.data) || request.resource.data.revokedAt is number))
        );

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
