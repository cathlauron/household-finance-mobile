rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /linkCodes/{code} {
      // A code is only readable for a short window after it's created — after
      // that, Firestore denies the read outright, so an old code sitting in a
      // screenshot or chat log can't be used to link into someone's data
      // indefinitely.
      allow get: if request.auth != null
        && request.time < resource.data.createdAt + duration.value(15, 'm');

      allow write: if request.auth != null &&
        (
          (request.resource.data.keys().hasAll(['codeSalt', 'encryptedSecret', 'encryptedHostData', 'hostUsername'])
            && request.resource.data.codeSalt is string
            && request.resource.data.encryptedSecret is string
            && request.resource.data.encryptedHostData is string
            && request.resource.data.hostUsername is string)
          ||
          (request.resource.data.finished == true
            && request.resource.data.householdId is string)
        );

      // Once a code has done its job (successfully used to link two
      // profiles), it's deleted outright rather than left sitting around
      // forever as a still-working decryption key.
      allow delete: if request.auth != null && resource.data.finished == true;

      allow list: if false;
    }

    match /households/{householdId} {
      allow get: if request.auth != null
        && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['data', 'updatedAt', 'members'])
        && request.resource.data.data is string
        && request.resource.data.updatedAt is number
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.keys().hasAll(['data', 'updatedAt']);

      // Lets someone who isn't a member yet join by adding their own uid to
      // the members list — this is what addMemberToHousehold() does when the
      // host finishes linking into a household the joiner already created.
      // Only the members field is allowed to change here (data/updatedAt are
      // untouched), and the person can only add themselves, not anyone else.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.auth.uid in request.resource.data.members;

      allow delete: if false;
      allow list: if false;
    }

    match /householdKeys/{username} {
      allow get: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['householdId', 'wrappedKey', 'updatedAt', 'ownerUid'])
        && request.resource.data.householdId is string
        && request.resource.data.wrappedKey is string
        && request.resource.data.updatedAt is number
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;

      allow list: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
